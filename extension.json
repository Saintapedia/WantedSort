{
	"name": "WantedSort",
	"version": "1.0.1",
	"author": [ "Tom Horsley" ],
	"url": "https://github.com/Saintapedia/WantedSort",
	"descriptionmsg": "wantedsort-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "specialpage",
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WantedSort\\": "includes/",
		"MediaWiki\\Extension\\WantedSort\\Maintenance\\": "maintenance/"
	},
	"SpecialPages": {
		"WantedSort": {
			"class": "MediaWiki\\Extension\\WantedSort\\SpecialWantedSort",
			"services": [
				"ConnectionProvider",
				"LinksMigration",
				"NamespaceInfo",
				"LinkBatchFactory",
				"MainWANObjectCache"
			]
		}
	},
	"config": {
		"WantedSortDefaultNamespace": {
			"value": null,
			"description": "Default namespace ID (integer) to pre-select on Special:WantedSort, or null to show all namespaces."
		}
	},
	"MessagesDirs": {
		"WantedSort": [ "i18n" ]
	},
	"ExtensionMessagesFiles": {
		"WantedSortAlias": "WantedSort.alias.php"
	},
	"ResourceModules": {
		"ext.wantedSort": {
			"styles": "resources/ext.wantedSort.css"
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "WantedSort"
	}
}
